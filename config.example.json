{
  "longPressMs": 500,
  "sequenceGapMs": 400,
  "restoreAudioRoute": true,
  "actionTimeoutSeconds": 30,
  "patterns": {
    ".": { "builtin": "spotify.playpause" },
    "..": { "builtin": "spotify.next" },
    "...": { "builtin": "spotify.previous" },
    "-": { "builtin": "input.togglemute" },
    ".-": { "run": "say 'Pressy is alive'" }
  }
}
